# 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
# 必须是内容已导入并验证过的那个库。写成别的名字,内容流水线会对着一张空库
# 生成一份"合法但丢掉手写层"的交付集 —— 校验全绿、数量看着也对,手写层却没了。
MYSQL_DATABASE=rootmap_1

# 微信小程序配置
WX_APPID=your_wechat_appid
WX_SECRET=your_wechat_secret

# 注:这里曾经有 JWT_SECRET —— 线上从来没用过 JWT,会话是 sessions 表里的
# 48 位随机 token(crypto.randomBytes(24)),对应的 verifyToken 死代码已删除。
# 不需要配任何密钥。

# 服务器配置
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# 日志配置
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Redis 配置（可选，用于缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# 邮件配置（可选，用于通知）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# 第三方服务配置
OPENAI_API_KEY=your_openai_api_key