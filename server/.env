# 数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=!QAZ2wsx
# 注意:内容数据已导入并验证的库是 rootmap_1(与代码默认一致);切勿改成空库 rootmap。
MYSQL_DATABASE=rootmap

# 微信小程序配置
WX_APPID=wxc08c59e14834576e
WX_SECRET=ec7f298b20cd5ac906c2a31137584db4

# JWT 配置
JWT_SECRET=rootmap-secret-key-2024

# 服务器配置
# 生产环境务必用真实环境变量覆盖:NODE_ENV=production、HOST=0.0.0.0、WX_SECRET=真实密钥
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# CORS 白名单(逗号分隔的 https 域名)。生产环境必须配置,例如:
# CORS_ORIGIN=https://api.your-domain.com
# 不配置时服务端暂放行所有来源(仅本地联调用,生产有风险)。
CORS_ORIGIN=

# 日志配置
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Redis 配置（可选，用于缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# 邮件配置（可选，用于通知）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# 第三方服务配置
OPENAI_API_KEY=your_openai_api_key