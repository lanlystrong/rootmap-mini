{
  "name": "rootmap-server",
  "version": "1.0.0",
  "description": "词根地图 - 服务端",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "server": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test \"test/**/*.test.js\" \"../tests/**/*.test.js\"",
    "test:server": "node --test \"test/**/*.test.js\"",
    "test:mini": "node --test \"../tests/**/*.test.js\"",
    "validate": "node ../scripts/validate-content.js",
    "generate:cet4": "node scripts/generate-cet4.js",
    "generate:content": "node scripts/generate-content.js",
    "audit": "node scripts/audit-content.js",
    "verify:db": "node scripts/verify-db.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "init-db": "node init-db.js",
    "migrate": "node -r esm src/migrate.js",
    "seed": "node src/seed.js",
    "content:import": "node scripts/content-import.js",
    "content:export": "node scripts/content-export.js",
    "backfill:rootcount": "node scripts/backfill-root-wordcount.js"
  },
  "keywords": [
    "english",
    "vocabulary",
    "roots",
    "learning",
    "wechat-mini-program"
  ],
  "author": "rootmap-team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.5.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "date-fns": "^2.30.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "mysql2": "^3.6.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "eslint": "^8.47.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "esm": "^3.2.25",
    "jest": "^29.6.4",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/migrate.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "eslintConfig": {
    "extends": [
      "standard"
    ],
    "env": {
      "node": true,
      "es2021": true
    },
    "parserOptions": {
      "ecmaVersion": 12
    }
  }
}
