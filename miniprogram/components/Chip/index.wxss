/* Chip 专属色系类:叠加在 app.wxss .chip 之上。
   用 .chip.chip-* 双类提升优先级,确保覆盖 app.wxss 的 .chip 底灰/灰字。 */
.chip.chip-cyan { background: #E0F2FE; color: #06B6D4; }     /* 浅蓝底青字(变体/前缀系) */
.chip.chip-blue { background: #DBEAFE; color: #3B82F6; }     /* 浅蓝底蓝字(词根系) */
.chip.chip-purple { background: #EDE9FE; color: #8B5CF6; }   /* 浅紫底紫字(后缀系) */
.chip.chip-green { background: #D1FAE5; color: #059669; }    /* 浅绿底绿字(完成/熟悉) */
