/* StatBar — 近 14 天双色细柱(纯 view)。new 蓝 #3B82F6 / reviews 绿 #10B981。 */
.sb {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  width: 100%;
}

.sb-col {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sb-plot {
  position: relative;
  width: 100%;
  height: 160rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: center;
}

.sb-bar {
  width: 12rpx;
  margin: 0 2rpx;
  border-radius: 6rpx 6rpx 0 0;
}

.sb-new { background: #3B82F6; }
.sb-rev { background: #10B981; }

/* 当日无活动:仅留底部小圆点作基线 */
.sb-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #E2E8F0;
  margin-bottom: 3rpx;
}

/* 横轴日期标签。原来 16rpx = iPhone 上 8px,是全项目最小的字 —— 14 天柱状图
   唯一的横轴信息,8px 读不出来。提到 22rpx(11px),是这个密度下能塞进
   14 列的最小值。 */
.sb-x {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1;
  color: #5F7089; /* 原 #94A3B8 只有 2.56:1 */
}

.sb-x-today {
  color: #3B82F6;
  font-weight: 600;
}
