/* AffixPop — 前后缀详情半屏弹层。 */
.affix-pop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.affix-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.4);
}

.affix-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  max-height: 72vh;
  overflow-y: auto;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
}

.affix-head {
  min-height: 56rpx;
}

.affix-ttl {
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}

.affix-text {
  font-size: 40rpx;
  font-weight: 800;
  margin-right: 16rpx;
}

/* 前缀青 / 后缀紫 —— 与 AffixRow、BreakdownBar、Chip 同一套。 */
.affix-text.is-pre { color: #0E7490; }
.affix-text.is-suf { color: #7C3AED; }

.affix-zh {
  font-size: 30rpx;
}

/* 关闭键:原来是 font-size:34rpx + padding:0 8rpx,实际可点区只有约 17px ——
   半屏弹层的 ✕ 是高频点击目标,低于 44px 基本点不准。
   撑成 88rpx 见方的隐形热区,glyph 本身仍是 34rpx 不变粗。 */
.affix-x {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin: -16rpx -20rpx -16rpx 0;
  font-size: 34rpx;
  color: #5F7089;
}

.affix-note {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.affix-wlabel {
  margin-top: 24rpx;
  font-size: 24rpx;
}

.affix-wlist {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.affix-w {
  background: #F1F5F9;
  color: #334155;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  margin: 0 12rpx 12rpx 0;
}
