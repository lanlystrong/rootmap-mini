.affix-row {
  padding: 22rpx 24rpx;
}

.affix-head {
  min-height: 44rpx;
}

.affix-main {
  flex-wrap: wrap;
}

.affix-text {
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

/* 前缀青 / 后缀紫 —— 与 BreakdownBar、Chip 同一套,改一处要改三处。
   32rpx/700 = 16px 粗体,还没到 WCAG 大字门槛(18.66px 粗体),按小字算 4.5:1。 */
.affix-text.is-pre { color: #0E7490; }
.affix-text.is-suf { color: #7C3AED; }

.affix-zh {
  font-size: 28rpx;
}

.affix-arrow {
  font-size: 22rpx;
  color: #5F7089; /* 原 #94A3B8 只有 2.6:1,这个「›」几乎看不见 */
}

.affix-note {
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.affix-words {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F1F5F9;
}

.affix-wchip {
  margin: 0 8rpx 8rpx 0;
}

.affix-empty {
  font-size: 24rpx;
}
