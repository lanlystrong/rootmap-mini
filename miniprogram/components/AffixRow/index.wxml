<view class="card affix-row" wx:if="{{affix}}">
  <view class="flex-between affix-head" bindtap="onHeadTap" hover-class="hover-dim">
    <view class="flex-row affix-main">
      <text class="affix-text {{affix.type === 'prefix' ? 'is-pre' : 'is-suf'}}">{{affix.text}}</text>
      <text class="affix-zh t-1">{{affix.zh}}</text>
    </view>
    <text class="affix-arrow t-3">{{expanded ? '收起 ▴' : '展开 ▾'}}</text>
  </view>
  <view class="affix-note t-3" wx:if="{{affix.note}}">{{affix.note}}</view>
  <view class="affix-words" wx:if="{{expanded}}">
    <text class="affix-empty t-3" wx:if="{{!words.length}}">暂无关联词</text>
    <chip wx:for="{{words}}" wx:key="id" class="affix-wchip" text="{{item.word}}" cls="chip-blue"
      data-id="{{item.id}}" bind:chipsel="onWordTap"></chip>
  </view>
</view>
