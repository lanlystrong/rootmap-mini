/* BreakdownBar — 词素着色拆解条。前缀青 / 词根蓝 / 后缀紫;type='none' 段仅留窄隙。 */
.bp {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
}

.bp-part {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
  margin-right: 10rpx;
}

.bp-gap {
  display: inline-block;
  width: 8rpx;
  flex-shrink: 0;
}

/* 拆解条三段的着色。14px/500 属小字,按 WCAG AA 全部 ≥4.5:1(白底实测
   5.36 / 5.17 / 5.70)。原来是 #06B6D4 / #3B82F6 / #8B5CF6 —— 只有 2.4~3.7:1,
   青色的「前缀」段在白卡片上几乎看不见,而这正是要靠颜色区分的关键信息。 */
.bp-pre  { color: #0E7490; }
.bp-root { color: #2563EB; }
.bp-suf  { color: #7C3AED; }

/* 长 none 残段(词典未收的派生后缀,如 -ation/-ology/-ific):灰色补全,
   不参与着色、不可点,但必须显示——否则拆解条拼不回完整单词。 */
.bp-none {
  color: #5F7089; /* 原 #9CA3AF 只有 2.6:1,补全段读不出来就等于没显示 */
  font-weight: 400;
}
