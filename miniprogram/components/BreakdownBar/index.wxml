<view class="bp">
  <block wx:for="{{segs}}" wx:key="_k">
    <text wx:if="{{item.gap}}" class="bp-gap"></text>
    <text wx:elif="{{item.visible}}" class="bp-part {{item.cls}}" data-ref="{{item.ref}}" data-type="{{item.type}}"
      bindtap="onTapPart" hover-class="{{item.cls === 'bp-none' ? '' : 'hover-dim'}}">{{item.text}}</text>
  </block>
</view>
