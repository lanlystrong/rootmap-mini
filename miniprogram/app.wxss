/**
 * 词根地图 app.wxss — 设计令牌(spec §8)+ 通用类。
 * 这些 class 是全局共享样式界面,Task 11-14 各页面均消费。
 * 令牌色值:
 *   主渐变      #3B82F6 → #4F46E5(学习)
 *   复习/完成   #10B981  | 忘了/警示 #EF4444 | 模糊 #F59E0B
 *   文字        标题 #0F172A / 正文 #334155 / 次要 #64748B
 *   背景 #F8FAFC,卡片白;大圆角 + pill 按钮 + 轻投影。
 *
 * ===== 第二套:词素着色(别当成"没用到的杂色"清掉)=====
 * 构词拆解条要给三种词素**视觉分区**,所以前缀/后缀另起一套色,刻意不跟主色蓝撞:
 *   前缀 青 #0E7490   后缀 紫 #7C3AED   词根 蓝 #2563EB
 * 见 components/Chip、BreakdownBar、AffixRow、AffixPop —— 四处必须同步改。
 *
 * ===== 无障碍:对比度是硬约束,不是观感偏好 =====
 * 下面这些色值都是**按 WCAG AA 4.5:1 反解出来的**,不是随手挑的。改之前先算:
 * 正文/小字(≥48rpx 以下)必须 ≥4.5:1,大字(≥48rpx 或粗体)≥3:1。
 * 曾经用过的 #06B6D4(青)/#8B5CF6(紫)/#3B82F6(蓝)/#94A3B8(灰)做小字,
 * 实测只有 2.1~3.7:1,在白底上几乎读不出来 —— 已被下面这组替换。
 */

/* ===== 基础 ===== */
page {
  background: #F8FAFC;
  color: #334155;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 微信原生 <button> 默认边框/背景清除,交由 .btn-* 全权控制 */
button {
  padding: 0;
  margin: 0;
  background: transparent;
  border-radius: 0;
  line-height: inherit;
}
button::after {
  border: none;
}

/* ===== 卡片 ===== */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
  padding: 24rpx;
}

/* ===== 主色渐变背景(学习/CTA)=====
   浅端是 #2563EB 而不是 #3B82F6:这个渐变上要压白字(按钮 16px、模式/筛选切换
   13~14px),而白字在 #3B82F6 上只有 3.68:1,达不到 4.5。深一档后是 5.17:1,
   渐变的蓝紫观感基本不变。 */
.grad {
  background: linear-gradient(135deg, #2563EB, #4F46E5);
  color: #FFFFFF;
}

/* ===== 文字灰阶 ===== */
.t-1 { color: #0F172A; }  /* 标题 */
.t-2 { color: #334155; }  /* 正文 */
.t-3 { color: #64748B; }  /* 次要/辅助 */

/* ===== 语义状态色(复习三键等)=====
   这些都落在白卡片上(.rv-ico ✓、.rd-check ✓)。原值 #10B981/#EF4444/#F59E0B
   在白底只有 2.15~3.76:1 —— 尤其"记得"和"模糊"两个,复习三键是本应用最核心
   的操作,状态色必须一眼可辨。压深后 4.83~5.48:1,红/绿/琥珀的语义不变。 */
.c-green { color: #047857; }  /* 记得/完成 */
.c-red   { color: #DC2626; }  /* 忘了/警示 */
.c-amber { color: #B45309; }  /* 模糊 */

/* ===== 胶囊 ===== */
.pill {
  border-radius: 999rpx;
}

/* ===== 按钮(pill 风格,自包含,可直接用于 <button>/<view>)===== */
.btn-primary,
.btn-ghost,
.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 48rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
}

.btn-primary {
  background: linear-gradient(135deg, #2563EB, #4F46E5);
  color: #FFFFFF;
}

.btn-ghost {
  background: #FFFFFF;
  color: #2563EB; /* 16px 文字在白底需 ≥4.5:1,#3B82F6 只有 3.68 */
  border: 1rpx solid rgba(59, 130, 246, 0.35);
}

.btn-danger {
  background: #EF4444;
  color: #FFFFFF;
}

/* ===== Chip 小标签 ===== */
.chip {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.4;
  background: #F1F5F9;
  color: #5F7089; /* 12px 小字 → 需 ≥4.5:1;#64748B 在 #F1F5F9 上只有 4.34 */
}

/* ===== 布局 ===== */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

/* ===== 按压反馈(所有可点元素统一 hover-class)===== */
.hover-dim {
  opacity: 0.7;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
