/* 复习页 — Task 13 复习会话闭环 */
.rv-page {
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.es {
  display: block;
  width: 100%;
}

/* ===== idle / done 汇总卡 ===== */
.rv-summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 32rpx 56rpx;
}

.rv-num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 24rpx;
}

.rv-sum-txt {
  font-size: 30rpx;
  font-weight: 600;
}

.rv-cap {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.rv-ico {
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

.rv-done-txt {
  font-size: 30rpx;
  text-align: center;
}

.rv-start,
.rv-finish,
.rv-go {
  width: 100%;
  margin-top: 48rpx;
}

.rv-guide {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
}

/* ===== 空态 CTA 间距 ===== */
.rv-go {
  margin-top: 8rpx;
}

/* ===== reviewing ===== */
.rv-review {
  padding-top: 8rpx;
}

.rv-progress {
  text-align: center;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.rv-hint {
  text-align: center;
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #5F7089; /* 原 #94A3B8 只有 2.56:1 */
}

.rv-actions {
  display: flex;
  margin-top: 36rpx;
}

.rv-act {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 100rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
  color: #FFFFFF;
}

.rv-act + .rv-act {
  margin-left: 20rpx;
}

/* 复习三键是本应用最核心的操作,白字压在底色上必须 ≥4.5:1。
   原值 红 #EF4444 / 琥珀 #F59E0B / 绿 #10B981 实测只有 3.76 / 2.15 / 2.54 ——
   "模糊"那个琥珀尤其糟,白字几乎糊在底色里。压深后 4.83 / 5.02 / 5.48,
   仍是清晰的 红=忘了 / 琥珀=模糊 / 绿=记得。 */
.rv-forgot { background: #DC2626; }  /* 忘了 q=1 */
.rv-hazy   { background: #B45309; }  /* 模糊 q=3 */
.rv-good   { background: #047857; }  /* 记得 q=5 */
