<view class="rv-page">
  <!-- ===== idle & 今天有到期 ===== -->
  <view wx:if="{{phase === 'idle' && dueTotal > 0}}" class="rv-idle">
    <view class="card rv-summary">
      <view class="rv-num grad">{{dueTotal}}</view>
      <text class="rv-sum-txt t-2">今日待复习</text>
      <text class="rv-cap t-3" wx:if="{{cap > 0}}">(上限 {{cap}})</text>
      <view class="rv-start btn-primary" bindtap="start">开始复习</view>
    </view>
    <view class="rv-guide t-3">翻面回想释义,再按「忘了 / 模糊 / 记得」自评</view>
  </view>

  <!-- ===== idle & 今天无到期 ===== -->
  <view wx:elif="{{phase === 'idle'}}" class="rv-idle">
    <empty-state class="es" text="今天没有到期的词,去词根地图学点新的"></empty-state>
    <view class="rv-go btn-primary" bindtap="goHome">去学习</view>
  </view>

  <!-- ===== reviewing ===== -->
  <view wx:elif="{{phase === 'reviewing'}}" class="rv-review">
    <view class="rv-progress t-3">{{i + 1}} / {{queue.length}}</view>
    <review-card word="{{cur}}" shown="{{shown}}" bind:flip="flip"></review-card>

    <!-- 未翻面:提示点击卡片;已翻面:三档自评 -->
    <view class="rv-hint t-3" wx:if="{{!shown}}">点击卡片翻面</view>
    <view class="rv-actions" wx:else>
      <view class="rv-act rv-forgot" data-q="1" bindtap="grade">忘了</view>
      <view class="rv-act rv-hazy" data-q="3" bindtap="grade">模糊</view>
      <view class="rv-act rv-good" data-q="5" bindtap="grade">记得</view>
    </view>
  </view>

  <!-- ===== done ===== -->
  <view wx:elif="{{phase === 'done'}}" class="rv-done">
    <view class="card rv-summary">
      <view class="rv-ico c-green">✓</view>
      <text class="rv-done-txt t-2">本次复习 {{done.total}} 张,还剩 {{done.dueLeft}} 张待复习</text>
      <view class="rv-finish btn-primary" bindtap="finish">完成</view>
    </view>
  </view>
</view>
