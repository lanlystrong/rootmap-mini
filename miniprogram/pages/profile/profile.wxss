/* 我的页 — Task 14: 统计 / 近14天 / 设置 / 重置 / 关于 */
.pf-page {
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* ===== 头部:连续打卡徽标 + 文案 ===== */
.pf-head {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.pf-badge {
  display: flex;
  align-items: center;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #F1F5F9;
}

.pf-badge-on {
  background: linear-gradient(135deg, #3B82F6, #4F46E5);
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.28);
}

.pf-badge-fire {
  font-size: 32rpx;
  line-height: 1;
  margin-right: 10rpx;
}

.pf-badge-txt {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #334155;
}

.pf-badge-on .pf-badge-txt {
  color: #FFFFFF;
}

.pf-headline {
  margin-top: 14rpx;
  font-size: 24rpx;
}

/* ===== 统计三卡 ===== */
.pf-stats {
  display: flex;
  margin-bottom: 20rpx;
}

.pf-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 8rpx 22rpx;
  box-sizing: border-box;
}

.pf-stat + .pf-stat {
  margin-left: 16rpx;
}

.pf-num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #F1F5F9;
  color: #0F172A;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
}

.pf-num.grad {
  background: linear-gradient(135deg, #3B82F6, #4F46E5);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.28);
}

.pf-num-txt {
  margin-top: 14rpx;
  font-size: 22rpx;
  text-align: center;
}

/* ===== 卡片通用 & 标题行 ===== */
.pf-card {
  margin-bottom: 20rpx;
}

.pf-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.pf-title {
  font-size: 30rpx;
  font-weight: 600;
}

.pf-legend {
  display: flex;
  align-items: center;
}

.pf-legend-item {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

/* .pf-legend-item 原本靠 margin-left 间隔,首个也会缩进 16rpx。
   分隔改由父级 gap 负责,首项不再缩进。 */
.pf-legend {
  gap: 20rpx;
}

.pf-legend > .pf-legend-item:first-child {
  margin-left: 0;
}

.pf-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 6rpx;
}

.pf-dot-new { background: #3B82F6; }
.pf-dot-rev { background: #10B981; }

.pf-legend-txt {
  font-size: 24rpx; /* 原 20rpx = 10px,是全项目第二小的字;图例文字读不清就分不出哪根柱是什么 */
}

/* StatBar host */
.pf-sb {
  display: block;
  width: 100%;
}

/* ===== 设置行 ===== */
.pf-row {
  min-height: 88rpx;
}

.pf-label {
  font-size: 28rpx;
}

.pf-val {
  display: flex;
  align-items: center;
}

.pf-val-txt {
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 8rpx;
}

.pf-caret {
  font-size: 32rpx;
  line-height: 1;
  color: #5F7089; /* 原 #94A3B8 只有 2.56:1 */
}

.pf-divider {
  height: 1rpx;
  background: #F1F5F9;
  margin: 8rpx 0;
}

/* ===== 重置 ===== */
.pf-reset {
  margin: 4rpx 0 24rpx;
}

.pf-reset-btn {
  width: 100%;
}

.pf-reset-hint {
  display: block;
  text-align: center;
  margin-top: 12rpx;
  font-size: 22rpx;
}

/* ===== 关于 ===== */
.pf-about-name {
  font-size: 30rpx;
  font-weight: 600;
}

.pf-about-ver {
  font-size: 24rpx;
}

.pf-about-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
}

/* ===== 用户头像/昵称(本地)===== */
.pf-profile {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.pf-avatar-btn {
  flex: 0 0 auto;
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border-radius: 50%;
  overflow: hidden;
  line-height: 1;
}

.pf-avatar-btn::after {
  border: none;
}

.pf-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #F1F5F9;
  display: block;
}

.pf-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #F1F5F9;
  font-size: 56rpx;
  color: #5F7089;
}

.pf-profile-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.pf-nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #0F172A;
  height: 48rpx;
  line-height: 48rpx;
}

.pf-nickname-ph {
  color: #5F7089; /* 原 #94A3B8 只有 2.56:1 */
  font-weight: 400;
}

.pf-profile-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
}

/* ===== 云端统计卡 ===== */
.pf-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.6;
}

.pf-cloud-err {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #EF4444;
}

.pf-cloud-loading {
  font-size: 24rpx;
  color: #64748B;
}

/* 会话过期提示条:一行说明 + 一个 88rpx 的重登按钮 */
.pf-relogin {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #F8FAFC;
}
.pf-relogin-txt {
  display: block;
  color: #5F7089;
  line-height: 1.6;
}
.pf-relogin-btn {
  margin-top: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 16rpx;
}

.pf-ov {
  display: flex;
  margin-top: 16rpx;
}

.pf-ov-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.pf-ov-num {
  font-size: 44rpx;
  font-weight: 600;
  color: #0F172A;
}

.pf-ov-txt {
  font-size: 24rpx;
}

.pf-gd {
  display: flex;
  gap: 6rpx;
  margin: 28rpx 0 8rpx;
  height: 12rpx;
  border-radius: 6rpx;
  overflow: hidden;
}

.pf-gd-bar {
  height: 100%;
}

/* 自评分布条。与 app.wxss 的 .c-red/.c-amber/.c-green、复习三键保持同一组色值,
   免得"记得"在复习页是绿的、在"我的"页又变回另一个绿。 */
.pf-gd-1 { background: #DC2626; }
.pf-gd-3 { background: #B45309; }
.pf-gd-5 { background: #047857; }

/* 分布条的图例(原色条只有三段颜色、没有任何文字说明,看了不知道是什么) */
.pf-gd-legend {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 10rpx;
  margin-bottom: 8rpx;
}

.pf-subhead {
  margin-top: 28rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.pf-rrow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F1F5F9;
}

.pf-rrow:last-child {
  border-bottom: none;
}

.pf-rt {
  min-width: 96rpx;
  font-size: 30rpx;
}

.pf-rz {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
}

.pf-rn {
  font-size: 24rpx;
}
