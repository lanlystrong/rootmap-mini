<navbar title="我的" />
<content-gate state="{{contentState}}" err="{{contentErr}}" bind:retry="onRetryContent"></content-gate>
<view class="pf-page" wx:if="{{contentReady}}">
  <!-- ===== 用户信息:头像 + 昵称(云端) ===== -->
  <view class="card pf-profile">
    <button class="pf-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{profile.avatarUrl}}" class="pf-avatar" src="{{profile.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="pf-avatar pf-avatar-empty">👤</view>
    </button>
    <view class="pf-profile-info">
      <input class="pf-nickname" type="nickname" value="{{profile.nickname}}" placeholder="点击设置昵称" placeholder-class="pf-nickname-ph" bindinput="onNicknameInput" bindblur="onNicknameBlur" bindconfirm="onNicknameBlur" />
      <text class="pf-profile-sub t-3">词根地图 · 云端同步</text>
    </view>
  </view>

  <!-- ===== 顶部头部卡:连续打卡徽标 + 文案 ===== -->
  <view class="card pf-head">
    <view class="pf-badge {{stats.streak > 0 ? 'pf-badge-on' : ''}}">
      <text class="pf-badge-fire">🔥</text>
      <text class="pf-badge-txt">连续 {{stats.streak}} 天</text>
    </view>
    <text class="pf-headline t-3">{{stats.streak > 0 ? '坚持就是胜利,继续保持!' : '今天还没有学习记录,去学一个新词吧'}}</text>
  </view>

  <!-- ===== 统计卡 ×3 ===== -->
  <view class="pf-stats">
    <view class="card pf-stat">
      <view class="pf-num grad">{{stats.dueToday}}</view>
      <text class="pf-num-txt t-3">今日待复习</text>
    </view>
    <view class="card pf-stat">
      <view class="pf-num">{{stats.learned}}</view>
      <text class="pf-num-txt t-3">累计已学</text>
    </view>
    <view class="card pf-stat">
      <view class="pf-num">{{stats.familiar}}</view>
      <text class="pf-num-txt t-3">熟悉词</text>
    </view>
  </view>

  <!-- ===== 近 14 天柱状 ===== -->
  <view class="card pf-card">
    <view class="pf-card-head">
      <text class="pf-title t-1">近 14 天</text>
      <view class="pf-legend">
        <view class="pf-legend-item">
          <view class="pf-dot pf-dot-new"></view>
          <text class="pf-legend-txt t-3">新学</text>
        </view>
        <view class="pf-legend-item">
          <view class="pf-dot pf-dot-rev"></view>
          <text class="pf-legend-txt t-3">复习</text>
        </view>
      </view>
    </view>
    <stat-bar class="pf-sb" data="{{last14}}"></stat-bar>
  </view>

  <!-- ===== 设置 ===== -->
  <view class="card pf-card">
    <view class="pf-card-head">
      <text class="pf-title t-1">设置</text>
    </view>
    <picker mode="selector" range="{{capOptions}}" value="{{capIndex}}" bindchange="onCapChange">
      <view class="pf-row flex-between">
        <text class="pf-label t-2">每日复习上限</text>
        <view class="pf-val">
          <text class="pf-val-txt t-1">{{capText}}</text>
          <text class="pf-caret t-3">›</text>
        </view>
      </view>
    </picker>
    <view class="pf-divider"></view>
    <view class="pf-row flex-between">
      <text class="pf-label t-2">学习页默认展开联想</text>
      <switch checked="{{settings.expandAssoc}}" color="#3B82F6" bindchange="onExpandChange" />
    </view>
    <view class="pf-divider"></view>
    <view class="pf-row flex-between" bindtap="onFeedbackTap" hover-class="hover-dim">
      <text class="pf-label t-2">意见反馈</text>
      <text class="pf-caret t-3">›</text>
    </view>
  </view>

  <!-- ===== 云端统计(仅登录)===== -->
  <view class="card pf-card" wx:if="{{cloud.authed}}">
    <view class="pf-card-head">
      <text class="pf-title t-1">云端统计</text>
      <text class="pf-cloud-loading t-3" wx:if="{{cloud.loading}}">加载中…</text>
    </view>
    <text class="pf-cloud-err" wx:if="{{cloud.err}}">{{cloud.err}}</text>
    <!-- 会话过期:本地学习进度不受影响(那是本地的),只有云端这块要重新登录一次 -->
    <view class="pf-relogin" wx:if="{{cloud.expired}}">
      <text class="pf-relogin-txt t-3">登录已过期,重新登录后继续同步云端数据</text>
      <view class="btn-ghost pf-relogin-btn" bindtap="onRelogin" hover-class="hover-dim">重新登录</view>
    </view>
    <block wx:if="{{cloud.overview}}">
      <view class="pf-ov">
        <view class="pf-ov-item"><text class="pf-ov-num grad">{{cloud.overview.totalStudied}}</text><text class="pf-ov-txt t-3">累计学习词</text></view>
        <view class="pf-ov-item"><text class="pf-ov-num">{{cloud.overview.reviewEvents}}</text><text class="pf-ov-txt t-3">云端复习</text></view>
        <view class="pf-ov-item"><text class="pf-ov-num">{{cloud.overview.accTxt}}</text><text class="pf-ov-txt t-3">正确率</text></view>
      </view>
      <view wx:if="{{cloud.overview.reviewEvents > 0}}">
        <view class="pf-gd">
          <view class="pf-gd-bar pf-gd-1" style="width:{{cloud.gdPct.q1}}%"></view>
          <view class="pf-gd-bar pf-gd-3" style="width:{{cloud.gdPct.q3}}%"></view>
          <view class="pf-gd-bar pf-gd-5" style="width:{{cloud.gdPct.q5}}%"></view>
        </view>
        <view class="pf-gd-legend">
          <view class="pf-legend-item">
            <view class="pf-dot" style="background:#DC2626"></view>
            <text class="pf-legend-txt t-3">忘了 {{cloud.gdPct.q1}}%</text>
          </view>
          <view class="pf-legend-item">
            <view class="pf-dot" style="background:#B45309"></view>
            <text class="pf-legend-txt t-3">模糊 {{cloud.gdPct.q3}}%</text>
          </view>
          <view class="pf-legend-item">
            <view class="pf-dot" style="background:#047857"></view>
            <text class="pf-legend-txt t-3">记得 {{cloud.gdPct.q5}}%</text>
          </view>
        </view>
      </view>
      <text class="pf-hint t-3" wx:else>暂无云端数据,先学几个词吧</text>
    </block>
    <stat-bar class="pf-sb" data="{{cloud.daily}}" wx:if="{{cloud.daily.length}}"></stat-bar>
    <view wx:if="{{cloud.roots.length}}">
      <view class="pf-subhead t-2">词根正确率 Top</view>
      <view class="pf-rrow" wx:for="{{cloud.roots}}" wx:key="rootId">
        <text class="pf-rt t-2">{{item.root}}</text>
        <text class="pf-rz t-3">{{item.zh}}</text>
        <text class="pf-rn t-3">{{item.reviews}} 次 · {{item.accTxt}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 重置学习数据 ===== -->
  <view class="pf-reset">
    <view class="btn-danger pf-reset-btn" bindtap="onResetTap" hover-class="hover-dim">重置学习数据</view>
    <text class="pf-reset-hint t-3">将清空学习与复习进度,设置保留</text>
  </view>

  <!-- ===== 关于 ===== -->
  <view class="card pf-about">
    <view class="flex-between">
      <text class="pf-about-name t-2">词根地图</text>
      <text class="pf-about-ver t-3">v{{version}}</text>
    </view>
    <view class="pf-about-desc t-3">内置 {{counts.roots}} 词根 / {{counts.affixes}} 词缀 /
      {{counts.words}} 单词 · 进度本地 · 账号云端同步</view>
    </view>

    <!-- ===== 反馈弹窗 ===== -->
    <view class="fb-mask" wx:if="{{feedbackVisible}}" bindtap="onFeedbackClose">
      <view class="fb-sheet" catchtap="noop">
        <view class="fb-head">
          <text class="fb-title t-1">意见反馈</text>
          <view class="fb-close t-3" bindtap="onFeedbackClose">✕</view>
        </view>
        <view class="fb-cats">
          <view wx:for="{{feedbackCats}}" wx:key="value"
                class="fb-cat {{feedback.category === item.value ? 'fb-cat-on' : ''}}"
                data-value="{{item.value}}" bindtap="onFeedbackCat">{{item.label}}</view>
        </view>
        <textarea class="fb-text" maxlength="2000" placeholder="请描述你的建议或遇到的问题…"
                  placeholder-class="fb-ph" value="{{feedback.content}}" bindinput="onFeedbackInput" />
        <view class="fb-count t-3">{{feedback.content.length}}/2000</view>
        <input class="fb-contact" type="text" placeholder="联系方式(选填,便于回访)"
               placeholder-class="fb-ph" value="{{feedback.contact}}" bindinput="onFeedbackContact" />
        <view class="fb-actions">
          <view class="btn-ghost fb-btn" bindtap="onFeedbackClose" hover-class="hover-dim">取消</view>
          <view class="btn-primary fb-btn {{submitting ? 'fb-disabled' : ''}}" bindtap="onFeedbackSubmit" hover-class="hover-dim">{{submitting ? '提交中…' : '提交'}}</view>
        </view>
      </view>
    </view>
    </view>
