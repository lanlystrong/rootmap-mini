/* 词根地图首页样式 — Task 11 */
.page {
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* ===== 搜索框 ===== */
.search-wrap {
  margin-bottom: 20rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 28rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #0F172A;
}

.search-ph {
  color: #5F7089; /* 原 #94A3B8 只有 2.56:1 —— 搜索框空态时唯一的提示文字 */
}

.search-clear {
  color: #5F7089;
  font-size: 30rpx;
  padding: 16rpx 0 16rpx 20rpx; /* 上下补足热区:清除键原本只有字那么高 */
}

/* ===== 模式切换 ===== */
.mode-bar {
  display: flex;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
}

/* 模式切换:原来是 line-height:60rpx,可点区只有 ~30px。改成 flex 居中 + 88rpx
   见方,视觉高度不变(mode-bar padding 6rpx 撑着),手指好按。 */
.mode-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 88rpx;
  font-size: 28rpx;
  color: #64748B;
  border-radius: 999rpx;
}

.mode-item.mode-on {
  background: linear-gradient(135deg, #2563EB, #4F46E5);
  color: #FFFFFF;
  font-weight: 600;
}

/* ===== 词根网格(2 列) ===== */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-cell {
  width: 48.5%;
  display: block;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

/* ===== 搜索命中 ===== */
.hit-sec {
  margin-bottom: 24rpx;
}

.hit-title {
  font-size: 24rpx;
  margin: 4rpx 4rpx 12rpx;
}

.hit-item {
  margin-bottom: 16rpx;
}

.hit-name {
  font-size: 34rpx;
  font-weight: 600;
}

.hit-zh {
  font-size: 26rpx;
}

.hit-phon {
  font-size: 24rpx;
}

.hit-variants {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.hit-chip {
  margin: 0 8rpx 8rpx 0;
}

/* ===== 前后缀列表 ===== */
.affix-cell {
  display: block;
  margin-bottom: 16rpx;
}

/* ===== 空态 host ===== */
.es {
  display: block;
  width: 100%;
}

/* ===== 进度筛选 chips ===== */
.filter-bar {
  display: flex;
  margin-bottom: 16rpx;
}

/* 进度筛选:原来 height:64rpx(~32px),不到 44px 的一半,容易误触相邻项。 */
.filter-chip {
  flex: 1;
  text-align: center;
  height: 88rpx;
  line-height: 88rpx;
  background: #FFFFFF;
  color: #64748B;
  font-size: 26rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
  margin-right: 16rpx;
}

.filter-chip:last-child {
  margin-right: 0;
}

.filter-chip.filter-on {
  background: linear-gradient(135deg, #2563EB, #4F46E5);
  color: #FFFFFF;
  font-weight: 600;
}

/* ===== 展开/收起全部 ===== */
.expand-row {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 12rpx;
}

.expand-toggle {
  font-size: 24rpx;
  padding: 4rpx 0;
}

/* ===== 分组区块 ===== */
.group {
  margin-bottom: 12rpx;
}

.group-head {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
}

.group-label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
}

.group-count {
  font-size: 24rpx;
  margin-left: 16rpx;
}

.group-progress {
  font-size: 24rpx;
  color: #2563EB;
  margin-left: 16rpx;
}

.group-chevron {
  font-size: 24rpx;
  color: #5F7089; /* 原 #94A3B8 2.56:1,展开箭头看不见就不知道这行能点 */
  margin-left: 12rpx;
}

.group .grid {
  margin-top: 16rpx;
}

/* ===== 前后缀区块 ===== */
.affix-sec {
  margin-bottom: 24rpx;
}

.affix-sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
}

.affix-sec-title {
  font-size: 30rpx;
  font-weight: 700;
}

.affix-sec-count {
  font-size: 24rpx;
}

.affix-group {
  margin-bottom: 12rpx;
}

.affix-list {
  margin-top: 16rpx;
}
