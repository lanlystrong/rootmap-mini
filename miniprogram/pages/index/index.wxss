/* 词根地图首页样式 — Task 11 */
.page {
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* ===== 搜索框 ===== */
.search-wrap {
  margin-bottom: 20rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 28rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #0F172A;
}

.search-ph {
  color: #94A3B8;
}

.search-clear {
  color: #94A3B8;
  font-size: 30rpx;
  padding: 0 0 0 20rpx;
}

/* ===== 模式切换 ===== */
.mode-bar {
  display: flex;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
}

.mode-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #64748B;
  line-height: 60rpx;
  border-radius: 999rpx;
}

.mode-item.mode-on {
  background: linear-gradient(135deg, #3B82F6, #4F46E5);
  color: #FFFFFF;
  font-weight: 600;
}

/* ===== 词根网格(2 列) ===== */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-cell {
  width: 48.5%;
  display: block;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

/* ===== 搜索命中 ===== */
.hit-sec {
  margin-bottom: 24rpx;
}

.hit-title {
  font-size: 24rpx;
  margin: 4rpx 4rpx 12rpx;
}

.hit-item {
  margin-bottom: 16rpx;
}

.hit-name {
  font-size: 34rpx;
  font-weight: 600;
}

.hit-zh {
  font-size: 26rpx;
}

.hit-phon {
  font-size: 24rpx;
}

.hit-variants {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.hit-chip {
  margin: 0 8rpx 8rpx 0;
}

/* ===== 前后缀列表 ===== */
.affix-cell {
  display: block;
  margin-bottom: 16rpx;
}

/* ===== 空态 host ===== */
.es {
  display: block;
  width: 100%;
}
