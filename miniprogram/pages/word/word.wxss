/* 学单词页 — Task 12 */
.w-page {
  padding: 24rpx 24rpx 240rpx;
  box-sizing: border-box;
}

.es {
  display: block;
  width: 100%;
}

/* ===== 释义列表 ===== */
.w-senses {
  margin-bottom: 20rpx;
}

.w-sense {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.w-sense:last-child {
  margin-bottom: 0;
}

.w-pos {
  width: 56rpx;
  flex-shrink: 0;
  color: #2563EB;
  font-size: 22rpx;
}

.w-zh {
  font-size: 30rpx;
}

.w-en {
  width: 100%;
  margin-top: 2rpx;
  font-size: 22rpx;
}

/* ===== 联想 chips ===== */
.w-chips {
  display: flex;
  flex-wrap: wrap;
  /* 抵消末行 chip 的 margin-bottom,避免卡片底部出现多余留白 */
  margin-bottom: -16rpx;
}

.w-chip {
  margin: 0 14rpx 16rpx 0;
}

.w-chip-item {
  position: relative;
  display: inline-flex;
  margin: 0 14rpx 16rpx 0;
}

/* 联想 chip 右上角的「同/反」角标。原来 18rpx = 9px,中文单字压在 9px 里
   基本糊成一团 —— 这是区分同义/反义的关键信息,提到 20rpx 并加一点字距。 */
.w-chip-mark {
  position: absolute;
  top: -12rpx;
  right: -14rpx;
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 1rpx;
  color: #FFFFFF;
  border-radius: 999rpx;
  padding: 4rpx 8rpx;
  z-index: 1;
}

/* 白字在绿/红上:绿底 2.9:1、红底 4.0:1。这两个是 10px 极小字,压深底色。 */
.mark-syn { background: #047857; }
.mark-ant { background: #DC2626; }

/* ===== 形近易混 ===== */
.w-conf {
  padding: 6rpx 0;
}

.w-cfword {
  font-size: 30rpx;
  font-weight: 600;
  color: #2563EB;
}

.w-cfdiff {
  margin-top: 2rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

/* ===== 词源助记 ===== */
.w-story {
  font-size: 26rpx;
  line-height: 1.8;
}

/* ===== 底部固定操作条 ===== */
.w-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(248, 250, 252, 0.95);
}

.w-act {
  flex: 1;
  height: 88rpx;
}

.w-act + .w-act {
  margin-left: 20rpx;
}

.w-act.act-off {
  opacity: 0.45;
}

/* 跳过:三级操作,故意弱化成纯文字 —— 三个按钮并排时两个 ghost 会显得像两个主操作 */
.w-act-skip {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #5F7089;
}
